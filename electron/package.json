{
  "name": "cryptofolio-desktop",
  "productName": "CryptoFolio",
  "version": "1.0.0",
  "description": "Gestión de portfolio y fiscalidad crypto para España — 100% local",
  "author": {
    "name": "SrMeirins",
    "url": "https://github.com/SrMeirins"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SrMeirins/CryptoFolio.git"
  },
  "main": "compiled/main.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "NODE_ENV=development electron compiled/main.js",
    "dist": "electron-builder --config electron-builder.config.js --publish always",
    "dist:win": "electron-builder --win --config electron-builder.config.js --publish always",
    "dist:mac": "electron-builder --mac --config electron-builder.config.js --publish always",
    "dist:linux": "electron-builder --linux --config electron-builder.config.js --publish always",
    "dist:local": "electron-builder --config electron-builder.config.js --publish never"
  },
  "dependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.0"
  }
}
