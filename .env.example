# ══════════════════════════════════════════════════════════════════
# CryptoFolio — Variables de entorno
# Copia este archivo como .env y rellena todos los valores.
# NUNCA subas el .env a git.
# ══════════════════════════════════════════════════════════════════

# ── Base de datos ───────────────────────────────────────────────
POSTGRES_USER=cryptotracker
POSTGRES_PASSWORD=cambia_esto_por_una_clave_segura
POSTGRES_DB=cryptotracker
DATABASE_URL=postgresql://cryptotracker:cambia_esto_por_una_clave_segura@postgres:5432/cryptotracker

# ── Backend ─────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3001

# ── Seguridad ───────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia_esto_genera_con_openssl_rand_hex_32

# ── Dominio (producción) ────────────────────────────────────────
# El dominio que Caddy usará para obtener el certificado SSL.
# Debe tener un registro A apuntando a la IP de este servidor.
DOMAIN=tudominio.com

# ── Precios ─────────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PRICE_REFRESH_INTERVAL_MS=60000
# Opcional: API key de CoinGecko Pro
# COINGECKO_API_KEY=tu_api_key_aqui

# ── Desarrollo local (no usar en producción) ────────────────────
# Solo necesarias si ejecutas con docker-compose.yml (dev).
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001
