# ══════════════════════════════════════════════════════════════════
# CryptoFolio — Variables de entorno
# Copia este archivo como .env y rellena los valores marcados.
# NUNCA subas el .env a git.
# ══════════════════════════════════════════════════════════════════

# ── Base de datos ───────────────────────────────────────────────
POSTGRES_USER=cryptotracker
POSTGRES_PASSWORD=cambia_esto                        # ← cambia esto
POSTGRES_DB=cryptotracker
DATABASE_URL=postgresql://cryptotracker:cambia_esto@postgres:5432/cryptotracker

# ── Backend ─────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3001

# ── Seguridad ───────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia_esto_minimo_32_caracteres          # ← cambia esto

# Cifrado de API keys de proveedores de verificación on-chain (ver network_api_keys)
# Genera con: openssl rand -base64 32
WALLET_SYNC_ENCRYPTION_KEY=cambia_esto                # ← cambia esto

# ── Precios ─────────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PRICE_REFRESH_INTERVAL_MS=60000
# Opcional: API key de CoinGecko Pro
# COINGECKO_API_KEY=tu_api_key_aqui

# ── Verificación de saldos on-chain (opcional por red) ──────────
# Sin ellas, esas redes concretas simplemente no se verifican (fail-safe,
# no rompe el resto). XRP Ledger, Hedera, Stellar, Bitcoin y Solana no
# necesitan key — solo Ethereum, Cardano y Polkadot Asset Hub.

# Etherscan (Ethereum, nativo + tokens ERC-20): https://etherscan.io/myapikey
# Free tier — el límite real observado es más estricto de lo documentado
# (ver THROTTLE_MS en etherscanProvider.ts), ya contemplado en el código.
ETHERSCAN_API_KEY=

# Blockfrost (Cardano): crea un PROYECTO en https://blockfrost.io/dashboard
# en la red "Cardano Mainnet" y copia su project_id (empieza por "mainnet...").
# OJO: un Personal Access Token del Dashboard (prefijo "bfm_live_...") NO
# sirve — es para gestión de cuenta/facturación, no para consultar datos de
# blockchain, y la API los rechaza con 403.
BLOCKFROST_API_KEY=

# Subscan (Polkadot Asset Hub): desde 2026 la key se obtiene vía la pasarela
# PubFi (https://pubfi.ai/products/subscan-api), no directamente en
# pro.subscan.io — el flujo de Subscan redirige ahí. El backend ya usa el
# formato de autenticación correcto (Bearer contra api.pubfi.ai).
SUBSCAN_API_KEY=
