# ══════════════════════════════════════════════════════════════════
# CryptoFolio — Variables de entorno
# Copia este archivo como .env y rellena los valores marcados.
# NUNCA subas el .env a git.
# ══════════════════════════════════════════════════════════════════

# ── Base de datos ───────────────────────────────────────────────
POSTGRES_USER=cryptotracker
POSTGRES_PASSWORD=cambia_esto                        # ← cambia esto
POSTGRES_DB=cryptotracker
DATABASE_URL=postgresql://cryptotracker:cambia_esto@postgres:5432/cryptotracker

# ── Backend ─────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3001

# ── Seguridad ───────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia_esto_minimo_32_caracteres          # ← cambia esto

# ── Precios ─────────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PRICE_REFRESH_INTERVAL_MS=60000
# Opcional: API key de CoinGecko Pro
# COINGECKO_API_KEY=tu_api_key_aqui
