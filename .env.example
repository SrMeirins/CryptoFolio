# ── Base de datos ──────────────────────────────────────────
POSTGRES_USER=cryptotracker
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=cryptotracker
POSTGRES_PORT=5432

# ── Backend ────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001
DATABASE_URL=postgresql://cryptotracker:changeme_strong_password@postgres:5432/cryptotracker

# ── Precios (CoinGecko - plan gratuito) ────────────────────
# Sin API key para el plan free. Con Pro descomentar:
# COINGECKO_API_KEY=your_key_here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PRICE_REFRESH_INTERVAL_MS=60000

# ── Frontend (solo desarrollo) ─────────────────────────────
# En producción (docker-compose.prod.yml) no se usan estas variables.
# El proxy lo gestiona nginx internamente.
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# ── Seguridad ──────────────────────────────────────────────
# Genera uno seguro con: openssl rand -hex 32
JWT_SECRET=changeme_jwt_secret_min_32_chars_long

# ── Producción ─────────────────────────────────────────────
# Puerto en el que escucha el frontend nginx (por defecto 80)
# FRONTEND_PORT=80

# CORS: URL de tu dominio si usas un reverse proxy externo (Caddy/Nginx host)
# Si usas docker-compose.prod.yml directamente, déjalo vacío.
# CORS_ORIGIN=https://tudominio.com
