{
  "name": "cryptotracker-backend",
  "version": "0.0.14",
  "description": "CryptoTracker backend — portfolio y fiscal España",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-db-assets",
    "copy-db-assets": "node scripts/copy-db-assets.js",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/pdfkit": "0.17.6",
    "cors": "2.8.6",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "8.5.2",
    "helmet": "7.2.0",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "pdfkit": "0.18.0",
    "pg": "8.20.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/morgan": "1.9.10",
    "@types/multer": "1.4.13",
    "@types/node": "20.19.41",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "eslint": "10.5.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
