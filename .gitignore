# ── Entorno y secretos ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
secrets.*
credentials.*
.venv/
__pycache__/

# ── CSVs y datos sensibles ─────────────────────────────────────────────────
*.csv
*.xlsx
*.xls

# ── Node ───────────────────────────────────────────────────────────────────
node_modules/
.npm/
npm-debug.log*
yarn-error.log
*.tsbuildinfo
# Reportes de cobertura de vitest — ningún vitest.config.ts la tiene
# activada hoy, pero mejor cubierto de antemano que olvidarlo el día que
# alguien corra --coverage.
coverage/

# Builds por proyecto (nunca el genérico dist/ — rompe electron-builder)
frontend/dist/
frontend/build/
backend/dist/
backend/build/
electron/compiled/
electron/dist/

# ── Docker / DB ────────────────────────────────────────────────────────────
postgres_data/
*.sql.bak

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*.swn

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log

# ── Temporal ───────────────────────────────────────────────────────────────
tmp/
temp/
.cache/

# ── Notas y seguimiento local (no es para el repo) ─────────────────────────
# Tracking de auditoría, wallets de verificación, revisión de código/refactor
# — todo local, jerarquizado por tema. Ver notas/README.md.
notas/

# ── Documentación interna (no publicar) ────────────────────────────────────
docs/binance-operations-pendientes.md
docs/test-csvs/

# ── Artefactos de extracción XLSX (estructura interna ZIP) ─────────────────
_rels/
docProps/
xl/
[Content_Types].xml

# ── Electron instaladores / output del packaging ───────────────────────────
releases/
backups/*
!backups/.gitkeep
